# DeepSeek API Key (required)
# Get yours at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: Pexels API key for image search in video generation
# Register free at https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-key-here

# FFmpeg binary path (required for audio extraction, TTS concatenation, video generation)
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
# Linux/macOS: /usr/bin/ffmpeg (or just "ffmpeg" if on PATH)
FFMPEG_PATH=ffmpeg

# Python interpreter path (required for ASR and TTS)
# Windows example: C:\Python314\python.exe
# Linux/macOS: python3 (or just "python3"/"python" if on PATH)
PYTHON_PATH=python
